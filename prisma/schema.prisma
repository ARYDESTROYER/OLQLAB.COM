generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  LEADER
}

enum SessionStatus {
  IN_PROGRESS
  SUBMITTED
}

enum SectionKind {
  PERSONALITY
  SCENARIO
}

enum QuestionType {
  LIKERT_TRAIT
  SJT_SINGLE
  FREE_TEXT
}

enum TenantType {
  ORGANIZATION
  SOLO
}

enum EnrollmentScope {
  USER
  TENANT
}

enum ReportAccessMode {
  KEEP_APP_ACCESS
  LINK_ONLY
  REVOKE
}

enum ReportGenerationMode {
  AUTO
  MANUAL
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum ReportWorkflow {
  AI_STANDARD
  MANUAL_PDF_UPLOAD
}

enum AssessmentQuestionPresentationMode {
  ALL_AT_ONCE
  ONE_AT_A_TIME
}

enum ReportDeliveryMethod {
  DASHBOARD_ONLY
  EMAIL_LINK
}

enum UnenrollJobStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Tenant {
  id         String     @id @default(cuid())
  name       String
  type       TenantType @default(ORGANIZATION)
  seatLimit  Int
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  users             User[]
  assessments       Assessment[]                 @relation("LegacyAssessmentTenant")
  ownedAssessments  Assessment[]                 @relation("AssessmentOwnerTenant")
  tenantEnrollments AssessmentTenantEnrollment[]
  seats             Seat[]
  invites           Invite[]
  auditLogs         AuditLog[]
  competencies      Competency[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String
  lastName      String
  role          Role
  tenantId      String
  managerId     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant                  Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager                 User?                            @relation("UserManager", fields: [managerId], references: [id])
  reports                 User[]                           @relation("UserManager")
  assessmentSessions      QuizSession[]
  userEnrollments         AssessmentUserEnrollment[]
  reportAccessOverrides   AssessmentReportAccessOverride[]
  reportShareTokens       AssessmentReportShareToken[]
  uploadedReportPdfAssets ReportPdfAsset[]
  retestEligibilities     RetestEligibility[]
  reportArchives          ReportArchive[]
  accounts                Account[]
  sessions                Session[]

  @@index([tenantId])
  @@index([managerId])
}

model Seat {
  id        String   @id @default(cuid())
  tenantId  String
  userEmail String
  assigned  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userEmail])
}

model Competency {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  impacts OptionImpact[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model AssessmentCompetency {
  id           String   @id @default(cuid())
  assessmentId String
  code         String
  name         String
  description  String?
  backfillTag  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  impacts    OptionImpact[]

  @@unique([assessmentId, code])
  @@index([assessmentId])
}

model Assessment {
  id            String   @id @default(cuid())
  tenantId      String?
  ownerTenantId String?
  title         String
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant                 Tenant?                          @relation("LegacyAssessmentTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  ownerTenant            Tenant?                          @relation("AssessmentOwnerTenant", fields: [ownerTenantId], references: [id], onDelete: SetNull)
  policy                 AssessmentPolicy?
  sections               AssessmentSection[]
  questions              Question[]
  sessions               QuizSession[]
  scores                 Score[]
  reports                Report[]
  retestEligibilities    RetestEligibility[]
  reportArchives         ReportArchive[]
  assessmentCompetencies AssessmentCompetency[]
  tenantEnrollments      AssessmentTenantEnrollment[]
  userEnrollments        AssessmentUserEnrollment[]
  unenrollJobs           AssessmentUnenrollJob[]
  reportAccessOverrides  AssessmentReportAccessOverride[]
  reportShareTokens      AssessmentReportShareToken[]

  @@index([tenantId])
  @@index([ownerTenantId])
}

model AssessmentSection {
  id           String      @id @default(cuid())
  assessmentId String
  title        String
  description  String?
  kind         SectionKind @default(PERSONALITY)
  sortOrder    Int

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@index([assessmentId])
}

model AssessmentPolicy {
  id                      String         @id @default(cuid())
  assessmentId            String         @unique
  showResultsToEmployee   Boolean        @default(true)
  resultReleaseDelayHours Int            @default(0)
  postSubmitMessage       String
  leaderCanViewFullReport Boolean        @default(true)
  reportWorkflow          ReportWorkflow @default(AI_STANDARD)
  questionPresentationMode AssessmentQuestionPresentationMode @default(ALL_AT_ONCE)
  randomizeQuestionOrder  Boolean        @default(false)
  submissionAlertAdminIds String[]       @default([])

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model Question {
  id           String       @id @default(cuid())
  assessmentId String
  sectionId    String?
  code         String?
  prompt       String
  imageUrl     String?
  imageAlt     String?
  imageCaption String?
  questionType QuestionType @default(LIKERT_TRAIT)
  category     String?
  trait        String?
  reverse      Boolean      @default(false)
  scaleMin     Int          @default(1)
  scaleMax     Int          @default(5)
  sortOrder    Int

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section    AssessmentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  answers    Answer[]
  options    QuestionOption[]

  @@index([assessmentId])
  @@index([sectionId])
}

model QuestionOption {
  id           String @id @default(cuid())
  questionId   String
  code         String
  text         String
  displayOrder Int

  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  impacts  OptionImpact[]
  answers  Answer[]

  @@unique([questionId, code])
  @@index([questionId])
}

model OptionImpact {
  id                     String  @id @default(cuid())
  optionId               String
  competencyId           String?
  assessmentCompetencyId String?
  delta                  Float

  option               QuestionOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  competency           Competency?           @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  assessmentCompetency AssessmentCompetency? @relation(fields: [assessmentCompetencyId], references: [id], onDelete: Cascade)

  @@unique([optionId, competencyId])
  @@unique([optionId, assessmentCompetencyId])
  @@index([optionId])
  @@index([competencyId])
  @@index([assessmentCompetencyId])
}

model AssessmentTenantEnrollment {
  id                 String               @id @default(cuid())
  assessmentId       String
  tenantId           String
  includeFutureUsers Boolean              @default(true)
  active             Boolean              @default(true)
  reportMode         ReportGenerationMode @default(AUTO)
  reportDelayHours   Int                  @default(0)
  createdByAdminId   String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, tenantId])
  @@index([assessmentId])
  @@index([tenantId])
  @@index([assessmentId, active])
}

model AssessmentUserEnrollment {
  id               String               @id @default(cuid())
  assessmentId     String
  userId           String
  active           Boolean              @default(true)
  reportMode       ReportGenerationMode @default(AUTO)
  reportDelayHours Int                  @default(0)
  createdByAdminId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
  @@index([assessmentId])
  @@index([userId])
  @@index([assessmentId, active])
}

model AssessmentUnenrollJob {
  id               String            @id @default(cuid())
  assessmentId     String
  targetScope      EnrollmentScope
  targetId         String
  effectiveAt      DateTime
  reportMode       ReportAccessMode  @default(KEEP_APP_ACCESS)
  notifyByEmail    Boolean           @default(false)
  linkTtlHours     Int?
  status           UnenrollJobStatus @default(PENDING)
  executedAt       DateTime?
  errorMessage     String?
  createdByAdminId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  assessment  Assessment                       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  overrides   AssessmentReportAccessOverride[]
  shareTokens AssessmentReportShareToken[]

  @@index([assessmentId])
  @@index([status, effectiveAt])
  @@index([assessmentId, status])
}

model AssessmentReportAccessOverride {
  id               String           @id @default(cuid())
  assessmentId     String
  userId           String
  mode             ReportAccessMode
  sourceJobId      String?
  createdByAdminId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  assessment Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceJob  AssessmentUnenrollJob? @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)

  @@unique([assessmentId, userId])
  @@index([assessmentId])
  @@index([userId])
}

model AssessmentReportShareToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  assessmentId  String
  userId        String
  expiresAt     DateTime
  maxDownloads  Int       @default(5)
  downloadsUsed Int       @default(0)
  revokedAt     DateTime?
  sourceJobId   String?
  createdAt     DateTime  @default(now())

  assessment Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceJob  AssessmentUnenrollJob? @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)

  @@index([assessmentId, userId])
  @@index([expiresAt])
}

model QuizSession {
  id           String        @id @default(cuid())
  assessmentId String
  userId       String
  status       SessionStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@unique([assessmentId, userId])
}

model RetestEligibility {
  id           String   @id @default(cuid())
  assessmentId String
  userId       String
  eligibleAt   DateTime
  setByAdminId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
  @@index([assessmentId])
  @@index([userId])
}

model Answer {
  id         String   @id @default(cuid())
  sessionId  String
  questionId String
  optionId   String?
  value      Int?
  textValue  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  QuizSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, questionId])
  @@index([optionId])
}

model Score {
  id                String   @id @default(cuid())
  assessmentId      String
  userId            String
  openness          Float
  conscientiousness Float
  extraversion      Float
  agreeableness     Float
  neuroticism       Float
  competencyJson    Json?
  createdAt         DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
}

model Report {
  id             String                @id @default(cuid())
  assessmentId   String
  userId         String
  narrativeJson  String
  status         ReportStatus          @default(PUBLISHED)
  availableAt    DateTime?
  deliveryMethod ReportDeliveryMethod?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt

  assessment Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  pdfAsset   ReportPdfAsset?

  @@unique([assessmentId, userId])
}

model ReportPdfAsset {
  id                String   @id @default(cuid())
  reportId          String   @unique
  fileName          String
  mimeType          String
  sizeBytes         Int
  pdfBytes          Bytes
  uploadedByAdminId String?
  uploadedAt        DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  report          Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedByAdmin User?  @relation(fields: [uploadedByAdminId], references: [id], onDelete: SetNull)

  @@index([uploadedByAdminId])
}

model ReportArchive {
  id              String    @id @default(cuid())
  assessmentId    String
  userId          String
  submittedAt     DateTime?
  archivedAt      DateTime  @default(now())
  archivedById    String?
  archiveReason   String?
  scoreJson       Json?
  narrativeJson   String?
  assessmentTitle String?
  participantName String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([userId])
  @@index([assessmentId, userId, archivedAt])
}

model Invite {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String
  metadata  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
