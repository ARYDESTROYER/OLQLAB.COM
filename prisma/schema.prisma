generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  LEADER
}

enum SessionStatus {
  IN_PROGRESS
  SUBMITTED
}

enum SectionKind {
  PERSONALITY
  SCENARIO
}

enum QuestionType {
  LIKERT_TRAIT
  SJT_SINGLE
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  seatLimit Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  assessments Assessment[]
  seats       Seat[]
  invites     Invite[]
  auditLogs   AuditLog[]
  competencies Competency[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String
  lastName      String
  role          Role
  tenantId      String
  managerId     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager            User?         @relation("UserManager", fields: [managerId], references: [id])
  reports            User[]        @relation("UserManager")
  assessmentSessions QuizSession[]
  retestEligibilities RetestEligibility[]
  reportArchives      ReportArchive[]
  accounts           Account[]
  sessions           Session[]

  @@index([tenantId])
  @@index([managerId])
}

model Seat {
  id        String   @id @default(cuid())
  tenantId  String
  userEmail String
  assigned  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userEmail])
}

model Competency {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  impacts OptionImpact[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Assessment {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy    AssessmentPolicy?
  sections  AssessmentSection[]
  questions Question[]
  sessions  QuizSession[]
  scores    Score[]
  reports   Report[]
  retestEligibilities RetestEligibility[]
  reportArchives      ReportArchive[]

  @@index([tenantId])
}

model AssessmentSection {
  id           String      @id @default(cuid())
  assessmentId String
  title        String
  description  String?
  kind         SectionKind @default(PERSONALITY)
  sortOrder    Int

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@index([assessmentId])
}

model AssessmentPolicy {
  id                      String  @id @default(cuid())
  assessmentId            String  @unique
  showResultsToEmployee   Boolean @default(true)
  resultReleaseDelayHours Int     @default(0)
  postSubmitMessage       String
  leaderCanViewFullReport Boolean @default(true)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model Question {
  id           String       @id @default(cuid())
  assessmentId String
  sectionId    String?
  code         String?
  prompt       String
  questionType QuestionType @default(LIKERT_TRAIT)
  category     String?
  trait        String?
  reverse      Boolean      @default(false)
  scaleMin     Int          @default(1)
  scaleMax     Int          @default(5)
  sortOrder    Int

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section    AssessmentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  answers    Answer[]
  options    QuestionOption[]

  @@index([assessmentId])
  @@index([sectionId])
}

model QuestionOption {
  id           String   @id @default(cuid())
  questionId    String
  code         String
  text         String
  displayOrder Int

  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  impacts  OptionImpact[]
  answers  Answer[]

  @@unique([questionId, code])
  @@index([questionId])
}

model OptionImpact {
  id           String @id @default(cuid())
  optionId     String
  competencyId String
  delta        Float

  option     QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  competency Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([optionId, competencyId])
  @@index([optionId])
  @@index([competencyId])
}

model QuizSession {
  id           String        @id @default(cuid())
  assessmentId String
  userId       String
  status       SessionStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@unique([assessmentId, userId])
}

model RetestEligibility {
  id           String   @id @default(cuid())
  assessmentId String
  userId       String
  eligibleAt   DateTime
  setByAdminId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
  @@index([assessmentId])
  @@index([userId])
}

model Answer {
  id         String   @id @default(cuid())
  sessionId  String
  questionId String
  optionId   String?
  value      Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  QuizSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, questionId])
  @@index([optionId])
}

model Score {
  id                String   @id @default(cuid())
  assessmentId      String
  userId            String
  openness          Float
  conscientiousness Float
  extraversion      Float
  agreeableness     Float
  neuroticism       Float
  competencyJson    Json?
  createdAt         DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
}

model Report {
  id            String   @id @default(cuid())
  assessmentId  String
  userId        String
  narrativeJson String
  createdAt     DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
}

model ReportArchive {
  id              String   @id @default(cuid())
  assessmentId    String
  userId          String
  submittedAt     DateTime?
  archivedAt      DateTime @default(now())
  archivedById    String?
  archiveReason   String?
  scoreJson       Json?
  narrativeJson   String?
  assessmentTitle String?
  participantName String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([userId])
  @@index([assessmentId, userId, archivedAt])
}

model Invite {
  id         String   @id @default(cuid())
  tenantId   String
  email      String
  token      String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String
  metadata  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
