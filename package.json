{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "env:check": "tsx scripts/validate-env.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "deploy:build": "npm run env:check && npm run prisma:migrate:deploy && npm run build",
    "prisma:seed": "prisma db seed",
    "assessment:payload:wissen": "tsx prisma/scripts/generate-wissen-upload-payload.ts",
    "assessment:import:payload": "node prisma/scripts/import-assessment-payload.mjs",
    "prisma:backfill:global-assessments": "tsx prisma/scripts/backfill-global-assessment-enrollments.ts",
    "prisma:rollback:global-assessments": "tsx prisma/scripts/rollback-global-assessment-enrollments.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@auth/core": "0.41.3",
    "markdown-it": "14.3.0",
    "nodemailer": "9.0.3",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "6.28.0",
    "tsx": {
      "esbuild": "0.28.1"
    }
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@fontsource/noto-sans": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "^6.8.2",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@vercel/blob": "2.6.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "next": "16.2.12",
    "next-auth": "4.24.15",
    "openai": "^6.22.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.8.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "regenerator-runtime": "0.14.1",
    "resend": "6.18.1",
    "sanitize-html": "2.17.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
